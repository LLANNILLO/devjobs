{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "es2024",
		"lib": ["ES2024"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src", "test"]
}
