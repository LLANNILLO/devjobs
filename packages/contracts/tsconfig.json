{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "es2023",
		"lib": ["ES2023"],
		"types": [],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src"]
}
